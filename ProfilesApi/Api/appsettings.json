{
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning"
            }
        },
        "WriteTo": [{
            "Name": "MongoDB",
            "Args": {
                "databaseUrl": "mongodb://localhost:1489/serilogdb",
                "collectionName": "logs",
                "cappedMaxSizeMb": "1024",
                "cappedMaxDocuments": "1000"
            }
        }]
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "sqlConnection": "Data Source=localhost,1433;Initial Catalog=InnoTest;User ID=sa;Password=aA123456!;TrustServerCertificate=True;MultipleActiveResultSets=true"
    }
}